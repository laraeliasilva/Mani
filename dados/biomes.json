d"],"uniqueBlocks":["Bamboo","Podzol","Jungle Log"],"spawningMobs":["Ocelot","Parrot","Panda","Chicken"],"structuresFound":["Jungle Pyramid"],"colors":{"grass":"#59C93C","water":"#3F76E4","foliage":"#30BB0B","sky":"#78A7FF"},"versionAdded":"1.14","rarity":"rare","notes":"The primary source of bamboo. Pandas have a higher spawn rate here. Podzol covers the ground. Bamboo can be used for scaffolding and as fuel."},{"name":"Sparse Jungle","id":"minecraft:sparse_jungle","dimension":"overworld","category":"warm","temperature":0.95,"precipitation":"rain","terrainFeatures":["scattered jungle trees","less dense vegetation than jungle"],"uniqueBlocks":["Jungle Log","Jungle Leaves","Vine"],"spawningMobs":["Ocelot","Chicken"],"structuresFound":[],"colors":{"grass":"#59C93C","water":"#3F76E4","foliage":"#30BB0B","sky":"#78A7FF"},"versionAdded":"1.7.2","rarity":"uncommon","notes":"A sparser version of the jungle with smaller trees and less undergrowth. Previously called Jungle Edge. Acts as a transition biome."},{"name":"Ocean","id":"minecraft:ocean","dimension":"overworld","category":"ocean","temperature":0.5,"precipitation":"rain","terrainFeatures":["moderate depth water","gravel floor","seagrass","kelp"],"uniqueBlocks":["Gravel","Seagrass","Kelp"],"spawningMobs":["Squid","Cod","Dolphin","Drowned"],"structuresFound":["Ocean Ruins","Shipwreck"],"colors":{"grass":"#8EB971","water":"#3F76E4","foliage":"#71A74D","sky":"#7BA4FF"},"versionAdded":"Beta 1.8","rarity":"common","notes":"Standard ocean biome with moderate depth. Contains kelp forests and seagrass. Dolphins can lead players to treasure."},{"name":"Deep Ocean","id":"minecraft:deep_ocean","dimension":"overworld","category":"ocean","temperature":0.5,"precipitation":"rain","terrainFeatures":["very deep water","ocean floor far below","ocean monuments"],"uniqueBlocks":["Gravel","Seagrass","Kelp"],"spawningMobs":["Squid","Cod","Dolphin","Drowned","Guardian"],"structuresFound":["Ocean Monument","Ocean Ruins","Shipwreck"],"colors":{"grass":"#8EB971","water":"#3F76E4","foliage":"#71A74D","sky":"#7BA4FF"},"versionAdded":"1.7.2","rarity":"common","notes":"Much deeper than regular oceans. Ocean Monuments with Elder Guardians generate exclusively in deep ocean variants. Guardians patrol around monuments."},{"name":"Warm Ocean","id":"minecraft:warm_ocean","dimension":"overworld","category":"ocean","temperature":0.5,"precipitation":"rain","terrainFeatures":["coral reefs","sea pickles","warm-colored water","sand floor"],"uniqueBlocks":["Coral Block","Coral Fan","Coral","Sea Pickle","Sand"],"spawningMobs":["Squid","Tropical Fish","Pufferfish","Dolphin"],"structuresFound":["Ocean Ruins","Shipwreck"],"colors":{"grass":"#8EB971","water":"#43D5EE","foliage":"#71A74D","sky":"#7BA4FF"},"versionAdded":"1.13","rarity":"uncommon","notes":"The only ocean biome with coral reefs. Tropical fish in many colorful variants swim here. Sea pickles provide underwater light. Coral dies if placed outside water."},{"name":"Lukewarm Ocean","id":"minecraft:lukewarm_ocean","dimension":"overworld","category":"ocean","temperature":0.5,"precipitation":"rain","terrainFeatures":["sand floor","kelp","seagrass","no coral reefs"],"uniqueBlocks":["Sand","Seagrass","Kelp"],"spawningMobs":["Squid","Cod","Tropical Fish","Pufferfish","Dolphin","Drowned"],"structuresFound":["Ocean Ruins","Shipwreck"],"colors":{"grass":"#8EB971","water":"#45ADF2","foliage":"#71A74D","sky":"#7BA4FF"},"versionAdded":"1.13","rarity":"common","notes":"Transition ocean between warm and normal. Sand floor but no coral reefs. Both tropical fish and cod can be found here."},{"name":"Cold Ocean","id":"minecraft:cold_ocean","dimension":"overworld","category":"ocean","temperature":0.5,"precipitation":"rain","terrainFeatures":["gravel floor","kelp","colder water color"],"uniqueBlocks":["Gravel","Seagrass","Kelp"],"spawningMobs":["Squid","Cod","Salmon","Drowned"],"structuresFound":["Ocean Ruins","Shipwreck"],"colors":{"grass":"#8EB971","water":"#3D57D6","foliage":"#71A74D","sky":"#7BA4FF"},"versionAdded":"1.13","rarity":"common","notes":"Cold ocean variant with darker, bluer water. Salmon spawn here alongside cod. Gravel forms the ocean floor."},{"name":"Deep Lukewarm Ocean","id":"minecraft:deep_lukewarm_ocean","dimension":"overworld","category":"ocean","temperature":0.5,"precipitation":"rain","terrainFeatures":["deep water","sand floor","kelp forests"],"uniqueBlocks":["Sand","Seagrass","Kelp"],"spawningMobs":["Squid","Cod","Tropical Fish","Dolphin","Drowned","Guardian"],"structuresFound":["Ocean Monument","Ocean Ruins","Shipwreck"],"colors":{"grass":"#8EB971","water":"#45ADF2","foliage":"#71A74D","sky":"#7BA4FF"},"versionAdded":"1.13","rarity":"uncommon","notes":"Deep variant of the lukewarm ocean. Ocean Monuments can generate here. Shares the warmer water color of the lukewarm ocean."},{"name":"Deep Cold Ocean","id":"minecraft:deep_cold_ocean","dimension":"overworld","category":"ocean","temperature":0.5,"precipitation":"rain","terrainFeatures":["deep water","gravel floor","kelp"],"uniqueBlocks":["Gravel","Seagrass","Kelp"],"spawningMobs":["Squid","Cod","Salmon","Drowned","Guardian"],"structuresFound":["Ocean Monument","Ocean Ruins","Shipwreck"],"colors":{"grass":"#8EB971","water":"#3D57D6","foliage":"#71A74D","sky":"#7BA4FF"},"versionAdded":"1.13","rarity":"uncommon","notes":"Deep variant of the cold ocean. Ocean Monuments can generate here. Darker water color than the lukewarm variant."},{"name":"Deep Frozen Ocean","id":"minecraft:deep_frozen_ocean","dimension":"overworld","category":"ocean","temperature":0.5,"precipitation":"snow","terrainFeatures":["deep water under ice","icebergs","blue ice","frozen surface patches"],"uniqueBlocks":["Ice","Packed Ice","Blue Ice","Gravel"],"spawningMobs":["Squid","Salmon","Drowned","Guardian","Polar Bear","Stray"],"structuresFound":["Ocean Monument","Ocean Ruins","Shipwreck"],"colors":{"grass":"#80B497","water":"#3938C9","foliage":"#60A17B","sky":"#8AABFF"},"versionAdded":"1.13","rarity":"uncommon","notes":"Deep variant of the frozen ocean. Features large icebergs and blue ice. Ocean Monuments can generate beneath the ice. Polar bears spawn on icebergs."},{"name":"Lush Caves","id":"minecraft:lush_caves","dimension":"overworld","category":"underground","temperature":0.5,"precipitation":"rain","terrainFeatures":["cave vegetation","clay pools","dripleaf","glow berries","azalea trees"],"uniqueBlocks":["Moss Block","Moss Carpet","Glow Berries","Cave Vines","Dripleaf","Azalea","Spore Blossom","Rooted Dirt","Hanging Roots"],"spawningMobs":["Axolotl","Glow Squid","Tropical Fish"],"structuresFound":[],"colors":{"grass":"#8EB971","water":"#3F76E4","foliage":"#71A74D","sky":"#7BA4FF"},"versionAdded":"1.18","rarity":"uncommon","notes":"A beautiful underground biome. Axolotls spawn exclusively here. Azalea trees on the surface indicate lush caves below. Glow berries provide natural light."},{"name":"Dripstone Caves","id":"minecraft:dripstone_caves","dimension":"overworld","category":"underground","temperature":0.5,"precipitation":"rain","terrainFeatures":["pointed dripstone stalactites and stalagmites","dripstone clusters","water pools"],"uniqueBlocks":["Pointed Dripstone","Dripstone Block"],"spawningMobs":["Drowned","Zombie","Skeleton","Spider","Creeper"],"structuresFound":[],"colors":{"grass":"#8EB971","water":"#3F76E4","foliage":"#71A74D","sky":"#7BA4FF"},"versionAdded":"1.18","rarity":"uncommon","notes":"Features pointed dripstone formations. Stalactites can drip water to fill cauldrons. Pointed dripstone deals extra fall damage. Large ore veins can generate here."},{"name":"Deep Dark","id":"minecraft:deep_dark","dimension":"overworld","category":"underground","temperature":0.8,"precipitation":"rain","terrainFeatures":["sculk growth","ancient cities","sculk sensors","extremely dark"],"uniqueBlocks":["Sculk","Sculk Vein","Sculk Sensor","Sculk Catalyst","Sculk Shrieker","Reinforced Deepslate"],"spawningMobs":["Warden"],"structuresFound":["Ancient City"],"colors":{"grass":"#8EB971","water":"#3F76E4","foliage":"#71A74D","sky":"#7BA4FF"},"versionAdded":"1.19","rarity":"rare","notes":"The most dangerous underground biome. Home to the Warden, which is attracted by vibrations and can deal massive damage. Ancient Cities contain unique loot including echo shards and disc fragments."},{"name":"Pale Garden","id":"minecraft:pale_garden","dimension":"overworld","category":"underground","temperature":0.7,"precipitation":"rain","terrainFeatures":["pale oak trees","pale hanging moss","eerie atmosphere","creaking hearts"],"uniqueBlocks":["Pale Oak Log","Pale Oak Leaves","Pale Hanging Moss","Pale Oak Planks","Creaking Heart"],"spawningMobs":["Creaking"],"structuresFound":[],"colors":{"grass":"#A0C4A0","water":"#3F76E4","foliage":"#8CAF8C","sky":"#79A6FF"},"versionAdded":"1.21.4","rarity":"rare","notes":"A pale, eerie biome featuring ghostly pale oak trees and hanging moss. The Creaking mob spawns here, animated by Creaking Heart blocks hidden in trees. Part of the Pale Garden update."},{"name":"Beach","id":"minecraft:beach","dimension":"overworld","category":"beach_special","temperature":0.8,"precipitation":"rain","terrainFeatures":["sand shoreline","sugar cane","gentle slope into water"],"uniqueBlocks":["Sand","Sandstone","Sugar Cane"],"spawningMobs":["Turtle"],"structuresFound":["Buried Treasure"],"colors":{"grass":"#91BD59","water":"#3F76E4","foliage":"#77AB2F","sky":"#78A7FF"},"versionAdded":"Beta 1.8","rarity":"common","notes":"Generates where land biomes meet the ocean. Turtles lay eggs on beaches. Buried treasure chests can be found using treasure maps from shipwrecks."},{"name":"Stony Shore","id":"minecraft:stony_shore","dimension":"overworld","category":"beach_special","temperature":0.2,"precipitation":"rain","terrainFeatures":["steep stone cliffs","gravel","rocky coastline"],"uniqueBlocks":["Stone","Gravel","Andesite","Diorite","Granite"],"spawningMobs":[],"structuresFound":[],"colors":{"grass":"#8AB689","water":"#3F76E4","foliage":"#6BA941","sky":"#7BA4FF"},"versionAdded":"1.7.2","rarity":"common","notes":"Rocky coastal biome where mountains meet the ocean. Features steep cliff faces. No passive mobs naturally spawn here."},{"name":"Mushroom Fields","id":"minecraft:mushroom_fields","dimension":"overworld","category":"beach_special","temperature":0.9,"precipitation":"rain","terrainFeatures":["mycelium ground","giant mushrooms","no hostile mob spawning"],"uniqueBlocks":["Mycelium","Red Mushroom Block","Brown Mushroom Block","Mushroom Stem"],"spawningMobs":["Mooshroom"],"structuresFound":[],"colors":{"grass":"#55C93F","water":"#3F76E4","foliage":"#2BBB0F","sky":"#78A7FF"},"versionAdded":"Beta 1.9 Pre-3","rarity":"very_rare","notes":"One of the rarest biomes. Hostile mobs cannot naturally spawn here, making it the safest biome. Mooshrooms are exclusive to this biome. Mycelium replaces grass."},{"name":"Windswept Hills","id":"minecraft:windswept_hills","dimension":"overworld","category":"beach_special","temperature":0.2,"precipitation":"rain","terrainFeatures":["steep hills","exposed stone","gravel patches","dramatic elevation changes"],"uniqueBlocks":["Stone","Gravel","Emerald Ore","Infested Stone"],"spawningMobs":["Cow","Pig","Sheep","Chicken","Llama","Goat"],"structuresFound":[],"colors":{"grass":"#8AB689","water":"#3F76E4","foliage":"#6BA941","sky":"#7BA4FF"},"versionAdded":"Alpha 1.2.0","rarity":"common","notes":"Previously called Extreme Hills. Emerald ore generates naturally here. Llamas and goats can spawn. Infested stone blocks contain silverfish."},{"name":"Windswept Gravelly Hills","id":"minecraft:windswept_gravelly_hills","dimension":"overworld","category":"beach_special","temperature":0.2,"precipitation":"rain","terrainFeatures":["gravel-covered hills","steep terrain","less vegetation"],"uniqueBlocks":["Gravel","Stone","Emerald Ore"],"spawningMobs":["Cow","Pig","Sheep","Chicken","Llama","Goat"],"structuresFound":[],"colors":{"grass":"#8AB689","water":"#3F76E4","foliage":"#6BA941","sky":"#7BA4FF"},"versionAdded":"1.7.2","rarity":"uncommon","notes":"A variant of windswept hills with gravel replacing much of the surface. Previously called Gravelly Mountains. Can be treacherous due to gravel slides."},{"name":"Windswept Forest","id":"minecraft:windswept_forest","dimension":"overworld","category":"beach_special","temperature":0.2,"precipitation":"rain","terrainFeatures":["forested steep hills","oak and spruce trees","dramatic terrain"],"uniqueBlocks":["Oak Log","Spruce Log","Stone","Emerald Ore"],"spawningMobs":["Cow","Pig","Sheep","Chicken","Llama","Goat"],"structuresFound":[],"colors":{"grass":"#8AB689","water":"#3F76E4","foliage":"#6BA941","sky":"#7BA4FF"},"versionAdded":"1.7.2","rarity":"uncommon","notes":"Forested variant of windswept hills. Combines dramatic elevation with dense tree coverage. Previously called Wooded Mountains."},{"name":"Nether Wastes","id":"minecraft:nether_wastes","dimension":"nether","category":"nether","temperature":2,"precipitation":"none","terrainFeatures":["netherrack terrain","lava seas","glowstone clusters","nether quartz ore"],"uniqueBlocks":["Netherrack","Glowstone","Nether Quartz Ore","Nether Gold Ore","Soul Sand","Gravel"],"spawningMobs":["Zombified Piglin","Ghast","Magma Cube","Enderman","Piglin","Strider"],"structuresFound":["Nether Fortress","Bastion Remnant"],"colors":{"grass":"#BFB755","water":"#3F76E4","foliage":"#AEA42A","sky":"#330808"},"versionAdded":"Alpha 1.2.0","rarity":"common","notes":"The original and most common Nether biome. Nether Fortresses and Bastion Remnants generate here. Nether quartz and gold ore are abundant."},{"name":"Soul Sand Valley","id":"minecraft:soul_sand_valley","dimension":"nether","category":"nether","temperature":2,"precipitation":"none","terrainFeatures":["soul sand and soul soil terrain","soul fire","basalt pillars","bone block fossils"],"uniqueBlocks":["Soul Sand","Soul Soil","Soul Fire","Basalt","Bone Block"],"spawningMobs":["Skeleton","Ghast","Enderman"],"structuresFound":["Nether Fortress","Bastion Remnant"],"colors":{"grass":"#BFB755","water":"#3F76E4","foliage":"#AEA42A","sky":"#1B4745"},"versionAdded":"1.16","rarity":"common","notes":"A haunting biome with blue soul fire and massive basalt pillars. Ghasts spawn at very high rates. Fossils made of bone blocks dot the landscape. Soul speed enchantment helps traverse soul sand."},{"name":"Crimson Forest","id":"minecraft:crimson_forest","dimension":"nether","category":"nether","temperature":2,"precipitation":"none","terrainFeatures":["crimson fungi","crimson nylium","shroomlights","weeping vines"],"uniqueBlocks":["Crimson Nylium","Crimson Stem","Crimson Hyphae","Shroomlight","Weeping Vines","Nether Wart Block","Crimson Fungus","Crimson Roots"],"spawningMobs":["Zombified Piglin","Piglin","Hoglin"],"structuresFound":["Nether Fortress","Bastion Remnant"],"colors":{"grass":"#BFB755","water":"#3F76E4","foliage":"#AEA42A","sky":"#330303"},"versionAdded":"1.16","rarity":"common","notes":"A red-themed fungal forest. Hoglins are the only hostile mob that drops food in the Nether. Piglins can be bartered with for various items. Shroomlights provide excellent light."},{"name":"Warped Forest","id":"minecraft:warped_forest","dimension":"nether","category":"nether","temperature":2,"precipitation":"none","terrainFeatures":["warped fungi","warped nylium","twisting vines","shroomlights"],"uniqueBlocks":["Warped Nylium","Warped Stem","Warped Hyphae","Shroomlight","Twisting Vines","Warped Wart Block","Warped Fungus","Warped Roots","Nether Sprouts"],"spawningMobs":["Enderman","Strider"],"structuresFound":["Nether Fortress","Bastion Remnant"],"colors":{"grass":"#BFB755","water":"#3F76E4","foliage":"#AEA42A","sky":"#1A051A"},"versionAdded":"1.16","rarity":"common","notes":"The safest Nether biome. Only Endermen and Striders spawn here, making it ideal for Nether bases. Warped fungus repels hoglins. The teal color scheme provides a surreal atmosphere."},{"name":"Basalt Deltas","id":"minecraft:basalt_deltas","dimension":"nether","category":"nether","temperature":2,"precipitation":"none","terrainFeatures":["basalt columns","blackstone terrain","lava pockets","ash particles"],"uniqueBlocks":["Basalt","Smooth Basalt","Blackstone","Magma Block"],"spawningMobs":["Magma Cube","Strider","Ghast"],"structuresFound":["Nether Fortress","Bastion Remnant"],"colors":{"grass":"#BFB755","water":"#3F76E4","foliage":"#AEA42A","sky":"#685F70"},"versionAdded":"1.16","rarity":"common","notes":"Volcanic biome with basalt columns and blackstone. Very difficult to traverse due to uneven terrain and lava pockets. Magma cubes spawn at extremely high rates. Ash particles fall from the sky."},{"name":"The End","id":"minecraft:the_end","dimension":"end","category":"end","temperature":0.5,"precipitation":"none","terrainFeatures":["central island","obsidian pillars","end crystals","bedrock portal"],"uniqueBlocks":["End Stone","Obsidian","Bedrock"],"spawningMobs":["Enderman","Ender Dragon"],"structuresFound":["End Gateway","Exit Portal"],"colors":{"grass":"#8EB971","water":"#3F76E4","foliage":"#71A74D","sky":"#000000"},"versionAdded":"1.0.0","rarity":"common","notes":"The central End island where the Ender Dragon boss fight takes place. Features obsidian pillars with end crystals. After defeating the dragon, End Gateways appear leading to the outer End."},{"name":"End Highlands","id":"minecraft:end_highlands","dimension":"end","category":"end","temperature":0.5,"precipitation":"none","terrainFeatures":["large end islands","chorus plants","end cities","end ships"],"uniqueBlocks":["End Stone","Chorus Plant","Chorus Flower","Purpur Block","End Stone Bricks","End Rod"],"spawningMobs":["Enderman","Shulker"],"structuresFound":["End City","End Ship"],"colors":{"grass":"#8EB971","water":"#3F76E4","foliage":"#71A74D","sky":"#000000"},"versionAdded":"1.9","rarity":"common","notes":"The primary outer End biome with End Cities containing valuable loot. End Ships have elytra and dragon heads. Shulkers guard End Cities and drop shulker shells for shulker boxes."},{"name":"End Midlands","id":"minecraft:end_midlands","dimension":"end","category":"end","temperature":0.5,"precipitation":"none","terrainFeatures":["medium-sized end islands","between highlands and barrens"],"uniqueBlocks":["End Stone"],"spawningMobs":["Enderman"],"structuresFound":["End City"],"colors":{"grass":"#8EB971","water":"#3F76E4","foliage":"#71A74D","sky":"#000000"},"versionAdded":"1.9","rarity":"common","notes":"Transition biome between End Highlands and End Barrens. End Cities can generate here but without End Ships. Less chorus vegetation than the highlands."},{"name":"End Barrens","id":"minecraft:end_barrens","dimension":"end","category":"end","temperature":0.5,"precipitation":"none","terrainFeatures":["barren end islands","edges of larger islands","void below"],"uniqueBlocks":["End Stone"],"spawningMobs":["Enderman"],"structuresFound":[],"colors":{"grass":"#8EB971","water":"#3F76E4","foliage":"#71A74D","sky":"#000000"},"versionAdded":"1.9","rarity":"common","notes":"The outermost End biome on the edges of islands. No structures generate here. Mostly barren end stone with no chorus plants."},{"name":"Small End Islands","id":"minecraft:small_end_islands","dimension":"end","category":"end","temperature":0.5,"precipitation":"none","terrainFeatures":["tiny floating islands","void between islands"],"uniqueBlocks":["End Stone"],"spawningMobs":["Enderman"],"structuresFound":[],"colors":{"grass":"#8EB971","water":"#3F76E4","foliage":"#71A74D","sky":"#000000"},"versionAdded":"1.9","rarity":"common","notes":"Small, isolated end stone islands floating in the void. Found in the transition area between the central island and the outer End. No structures or chorus plants generate here."}]}